DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/malappuramnikah?sslmode=disable"
PORT=3333
NODE_ENV=development

# JWT — ACCESS_TOKEN_SECRET and JWT_SECRET must match
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
JWT_SECRET=your-access-token-secret

# MSG91 SMS OTP (https://msg91.com) — leave unset for dev mode (OTP returned in API response)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional: Cloudinary for media uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
