generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  profile_for    String
  gender         String
  first_name     String
  last_name      String
  cast           String
  location       String
  mobile_number  String    @unique 
  password       String
  dob            String
  status         String    @default("in_active")
  is_premium     Boolean   @default(false)
  is_new_user    Boolean   @default(true)
  last_login     DateTime?
  profile_details Json?
  kyc_status         String    @default("NOT_SUBMITTED")
  kyc_document_type  String?
  kyc_front_url      String?
  kyc_back_url       String?
  kyc_rejected_reason String?
  kyc_submitted_at   DateTime?
  kyc_verified_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  verify         Verify[]
  sent_interests     Interest[] @relation("SentInterests")
  received_interests Interest[] @relation("ReceivedInterests")

  @@map("user")
}


model Verify {
  id            Int       @id @default(autoincrement())
  user_id       Int       
  otp_code      String    
  expires_at    DateTime  
  is_verified   Boolean   @default(false)
  created_at    DateTime  @default(now()) 
  user          User      @relation(fields: [user_id], references: [id])

  @@map("verify") // Maps the model to the "verify" table
}

model Interest {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sender      User     @relation("SentInterests", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedInterests", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id])
  @@map("interest")
}

model Message {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  content     String
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("message")
}

model Notification {
  id          Int      @id @default(autoincrement())
  user_id     Int
  sender_id   Int
  type        String   // INTEREST_SENT, INTEREST_ACCEPTED, NEW_MESSAGE
  title       String
  message     String
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("notification")
}